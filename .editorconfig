# ---------------------------------------------------------------------------
# Test projects. Two globs, matching either naming direction:
#   [**.Tests/**.cs]   ends in ".Tests"      -> Something.Something.Tests
#   [**Tests.*/**.cs]  starts with "Tests."  -> Tests.Something.Something
# The second also catches a Tests segment in the middle (Core.Tests.Integration).
# Placed after the library section so Core.Contracts.Tests gets test rules.
# ---------------------------------------------------------------------------

[**.Tests/**.cs]

# Given_When_Then method names, no Async suffix, unused [Theory] parameters and
# `null!` in arrange blocks are all conventional here.
dotnet_naming_rule.non_field_members_should_be_pascal_case.severity = none
dotnet_naming_rule.async_methods_end_in_async.severity = none
dotnet_code_quality_unused_parameters = non_public:silent
dotnet_diagnostic.CS1591.severity = none
dotnet_diagnostic.CS8625.severity = suggestion

[**Tests.*/**.cs]

dotnet_naming_rule.non_field_members_should_be_pascal_case.severity = none
dotnet_naming_rule.async_methods_end_in_async.severity = none
dotnet_code_quality_unused_parameters = non_public:silent
dotnet_diagnostic.CS1591.severity = none
dotnet_diagnostic.CS8625.severity = suggestion

# ---------------------------------------------------------------------------
# Generated code. Must stay last: these globs override every section above.
# Roslyn already treats *.g.cs and *.Designer.cs as generated. EF migration
# bodies it does not - they are ordinary C# it will flag, and you cannot fix
# them because the next `dotnet ef migrations add` regenerates the file.
# ---------------------------------------------------------------------------

[*.{g,generated,Designer,AssemblyInfo}.cs]
generated_code = true
dotnet_analyzer_diagnostic.severity = none
dotnet_diagnostic.CS1591.severity = none

[**Migrations/**.cs]
generated_code = true
dotnet_analyzer_diagnostic.severity = none
dotnet_diagnostic.CS1591.severity = none
