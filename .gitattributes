# Auto detect text files and normalize line endings to LF in the repo,
# checked out as-is (matches core.autocrlf=input behavior on all platforms).
* text=auto eol=lf

# Sources that should always be LF regardless of platform
*.cs text eol=lf diff=csharp
*.csproj text eol=lf
*.sln text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Windows-specific scripts must keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files must not be modified
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.snk binary
*.dll binary
*.pdb binary
